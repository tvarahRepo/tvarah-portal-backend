@startuml Tvarah Technical Diagram

top to bottom direction
skinparam linetype polyline
skinparam nodesep 100
skinparam ranksep 120

skinparam entity {
    BackgroundColor #FFFDE7
    BorderColor     #795548
    FontSize        13
    FontColor       #1A1A2E
    AttributeFontSize 12
}

skinparam arrow {
    Color           #795548
    FontSize        10
    FontColor       #555555
}

' ═══════════════════════════════════════════
' ROW 0 — User · Client · Job Description
' ═══════════════════════════════════════════

together {
    entity "user" as user {
        * id               : UUID          <<PK>>
        --
        first_name         : VARCHAR(150)  <<NULL>>
        last_name          : VARCHAR(150)  <<NULL>>
        * email            : VARCHAR(255)  <<INDEX>>
        * keycloak_user_id : UUID          <<UNIQUE, INDEX>>
        * role             : VARCHAR(50)   <<INDEX>>
        status             : UUID          <<FK, INDEX>>
        created_on         : TIMESTAMPTZ   DEFAULT now()
        updated_on         : TIMESTAMPTZ   DEFAULT now()
    }

    entity "client" as client {
        * id           : UUID          <<PK>>
        --
        * name         : VARCHAR(200)  <<UNIQUE, INDEX>>
        industry       : VARCHAR(100)  <<FK, INDEX, NULL>>
        size           : INT           <<NULL>>
        recruiter_id   : UUID          <<FK, INDEX, NULL>>
        status         : UUID          <<FK, INDEX>>
        created_on     : TIMESTAMPTZ   DEFAULT now()
        updated_on     : TIMESTAMPTZ   DEFAULT now()
    }

    entity "job_description" as job_description {
        * id                       : UUID          <<PK>>
        --
        client_id                  : UUID          <<FK, INDEX, NULL>>
        * job_title_id             : UUID          <<FK, INDEX>>
        * job_description_text     : TEXT
        ..
        experience_min_yrs         : DECIMAL(4,1)
        experience_max_yrs         : DECIMAL(4,1)
        ..
        required_skills            : TEXT[]
        must_have_skills           : TEXT[]
        good_have_skills           : TEXT[]
        ..
        salary_min                 : DECIMAL(10,2)
        salary_max                 : DECIMAL(10,2)
        ..
        total_positions            : INT           DEFAULT 2
        total_positions_selected   : INT           DEFAULT 0
        total_rounds               : INT           DEFAULT 2
        ..
        status                     : UUID          <<FK>>
        closed_on                  : TIMESTAMPTZ
        ..
        jd_score                   : DECIMAL(5,2)
        non_negotiable_rules       : JSONB
        ..
        created_on                 : TIMESTAMPTZ   DEFAULT now()
        updated_on                 : TIMESTAMPTZ   DEFAULT now()
    }
}

' ═══════════════════════════════════════════
' ROW 1 — Core Reference Tables
' ═══════════════════════════════════════════

together {
    entity "industry" as industry {
        * id               : UUID         <<PK>>
        --
        * name             : VARCHAR(150) <<UNIQUE, INDEX>>
        * sector           : VARCHAR(100) <<INDEX>>
        naics_ref_number   : VARCHAR(100) <<UNIQUE>>
        aliases            : VARCHAR(255)
    }

    entity "status" as status {
        * id          : UUID         <<PK>>
        --
        * name        : VARCHAR(100)
        * type        : VARCHAR(100) <<INDEX>>
        description   : TEXT
        .. UNIQUE (name, type) ..
    }

    entity "department" as department {
        * id              : UUID         <<PK>>
        --
        * name            : VARCHAR(100) <<UNIQUE, INDEX>>
        * code            : VARCHAR(20)  <<UNIQUE>>
        parent_department : VARCHAR(100) <<FK, INDEX, NULL>>
    }
}

' ═══════════════════════════════════════════
' ROW 2 — Role / Work Reference Tables
' ═══════════════════════════════════════════

together {
    entity "job_title" as job_title {
        * id              : UUID         <<PK>>
        --
        * name            : VARCHAR(150) <<INDEX>>
        * department      : VARCHAR(100) <<FK, INDEX>>
        seniority_level   : VARCHAR(50)  <<INDEX>>
    }

    entity "designation" as designation {
        * id         : UUID          <<PK>>
        --
        * name       : VARCHAR(150)  <<UNIQUE, INDEX>>
        level        : VARCHAR(50)   <<INDEX, NULL>>
        category     : VARCHAR(100)  <<INDEX, NULL>>
        department   : VARCHAR(100)  <<FK, INDEX, NULL>>
        alias        : VARCHAR(150)  <<NULL>>
        is_active    : BOOLEAN       DEFAULT TRUE
    }

    entity "skill" as skill {
        * id            : UUID          <<PK>>
        --
        * name          : VARCHAR(200)  <<INDEX>>
        * category      : VARCHAR(200)  <<INDEX>>
        tier            : VARCHAR(50)   <<INDEX, NULL>>
        * department    : VARCHAR(100)  <<FK, INDEX>>
        is_technical    : BOOLEAN       DEFAULT FALSE
        is_verified     : BOOLEAN       DEFAULT FALSE
    }
}

' ═══════════════════════════════════════════
' ROW 3 — Education Reference Tables
' ═══════════════════════════════════════════

together {
    entity "institution" as institution {
        * id                    : UUID          <<PK>>
        --
        * name                  : VARCHAR(200)  <<INDEX>>
        type                    : VARCHAR(100)  <<INDEX, NULL>>
        parent_institution_id   : UUID          <<FK, INDEX, NULL>>
        alias                   : VARCHAR(200)  <<INDEX, NULL>>
        category                : VARCHAR(100)  <<INDEX, NULL>>
        tier                    : VARCHAR(100)  <<INDEX, NULL>>
        * city                  : VARCHAR(150)  <<INDEX>>
        * state                 : VARCHAR(150)  <<INDEX>>
        ranking                 : VARCHAR(100)  <<INDEX, NULL>>
        is_verified             : BOOLEAN       DEFAULT FALSE
    }

    entity "degree" as degree {
        * id       : UUID          <<PK>>
        --
        * name     : VARCHAR(150)  <<UNIQUE, INDEX>>
        level      : VARCHAR(50)   <<INDEX, NULL>>
        * category : VARCHAR(150)  <<INDEX>>
        * code     : VARCHAR(20)   <<UNIQUE>>
    }

    entity "specialization" as specialization {
        * id    : UUID         <<PK>>
        --
        * name  : VARCHAR(150) <<UNIQUE, INDEX>>
        alias   : VARCHAR(100) <<NULL>>
    }

    entity "specialization_degree_map" as specialization_degree_map {
        * id                : UUID <<PK>>
        --
        * specialization_id : UUID <<FK, INDEX>>
        * degree_id         : UUID <<FK, INDEX>>
    }
}

' ═══════════════════════════════════════════
' ROW 4 — Company
' ═══════════════════════════════════════════

entity "company" as company {
    * id                  : UUID         <<PK>>
    --
    * name                : VARCHAR(200) <<UNIQUE, INDEX>>
    name_alias            : VARCHAR(200) <<INDEX>>
    type                  : VARCHAR(100) <<INDEX>>
    industry              : VARCHAR(150) <<FK, INDEX>>
    headquarter_city      : VARCHAR(100)
    headquarter_state     : VARCHAR(100)
    headquarter_country   : VARCHAR(100)
    founded_year          : INT
    no_of_employees       : INT
    review_count          : INT          DEFAULT 0
    avg_rating            : DECIMAL(3,1) CHECK 0–5
    mca_verified          : BOOLEAN      DEFAULT FALSE
}

' ═══════════════════════════════════════════
' ROW 5 — Candidate (Core)
' ═══════════════════════════════════════════

entity "candidate" as candidate {
    * id                  : UUID          <<PK>>
    --
    * first_name          : VARCHAR(150)
    * last_name           : VARCHAR(150)
    email                 : VARCHAR(255)  <<UNIQUE, INDEX>>
    address               : TEXT
    city                  : VARCHAR(150)
    country               : VARCHAR(150)
    * phone_number        : VARCHAR(20)   <<INDEX>>
    whatsapp_number       : VARCHAR(20)   <<INDEX>>
    status_id             : UUID          <<FK, INDEX>>
    * job_title_id        : UUID          <<FK, INDEX>>
    total_experience      : DECIMAL(12,2) <<INDEX>>
    relative_experience   : DECIMAL(12,2) <<INDEX>>
    * designation         : VARCHAR(150)  <<FK, INDEX>>
    * company             : VARCHAR(200)  <<FK, INDEX>>
    * created_on          : TIMESTAMPTZ   <<INDEX>>
    updated_on            : TIMESTAMPTZ
    * created_by          : VARCHAR(200)
    updated_by            : VARCHAR(200)
}

' ═══════════════════════════════════════════
' ROW 6 — Candidate 1:1 Extensions
' ═══════════════════════════════════════════

together {
    entity "candidate_preference" as candidate_preference {
        * id                        : UUID          <<PK>>
        --
        * candidate_id              : UUID          <<FK, UNIQUE, INDEX>>
        current_location            : VARCHAR(100)  <<INDEX>>
        primary_preferred_location  : VARCHAR(100)
        preferred_locations         : TEXT[]
        can_relocate                : BOOLEAN       DEFAULT FALSE
        preferred_job_title_id      : UUID          <<FK, INDEX>>
        current_ctc                 : DECIMAL(12,2)
        expected_ctc_min            : DECIMAL(12,2)
        expected_ctc_max            : DECIMAL(12,2)
        ctc_currency                : VARCHAR(5)    DEFAULT 'INR'
        work_mode_preference        : VARCHAR(50)   <<INDEX>>
        * created_on                : TIMESTAMPTZ   DEFAULT now()
        created_by                  : VARCHAR(200)
        updated_on                  : TIMESTAMPTZ   DEFAULT now()
        updated_by                  : VARCHAR(200)
    }

    entity "candidate_notice_period" as candidate_notice_period {
        * id                     : UUID          <<PK>>
        --
        * candidate_id           : UUID          <<FK, UNIQUE, INDEX>>
        * company                : VARCHAR(200)  <<FK, INDEX>>
        is_in_notice_period      : BOOLEAN       DEFAULT FALSE
        * notice_period_duration : SMALLINT
        resignation_date         : TIMESTAMPTZ   <<INDEX, NULL>>
        earliest_joining_date    : TIMESTAMPTZ   <<INDEX, NULL>>
        last_working_date        : TIMESTAMPTZ   <<INDEX, NULL>>
        created_by               : VARCHAR(200)
        updated_by               : VARCHAR(200)
        * created_on             : TIMESTAMPTZ   DEFAULT now()
        updated_on               : TIMESTAMPTZ   DEFAULT now()
    }
}

' ═══════════════════════════════════════════
' ROW 7 — Candidate Scoring & Summary
' ═══════════════════════════════════════════

together {
    entity "candidate_score" as candidate_score {
        * id                                   : UUID          <<PK>>
        --
        * candidate_id                         : UUID          <<FK, INDEX>>
        ..
        overall_score                          : DECIMAL(5,2)  <<INDEX>>
        overall_strength                       : VARCHAR(50)
        ..
        education_quality_score                : DECIMAL(5,2)
        institution_credibility_score          : DECIMAL(5,2)
        academic_alignment_score               : DECIMAL(5,2)
        timeline_integrity_score               : DECIMAL(5,2)
        ..
        experience_quality_score               : DECIMAL(5,2)
        company_quality_signal_score           : DECIMAL(5,2)
        role_progression_score                 : DECIMAL(5,2)
        experience_sufficiency_score           : DECIMAL(5,2)
        ..
        skill_depth_score                      : DECIMAL(5,2)
        depth_of_usage_score                   : DECIMAL(5,2)
        breadth_tooling_clarity_score          : DECIMAL(5,2)
        ..
        domain_depth_score                     : DECIMAL(5,2)
        domain_consistency_score               : DECIMAL(5,2)
        domain_impact_evidence_score           : DECIMAL(5,2)
        domain_language_signal_strength_score  : DECIMAL(5,2)
        ..
        feedback_comments                      : TEXT
        drop_flag                              : BOOLEAN       DEFAULT FALSE
        fraud_risk                             : VARCHAR(50)   <<INDEX>>
        fraud_status                           : BOOLEAN       DEFAULT FALSE <<INDEX>>
        updated_on                             : TIMESTAMPTZ   DEFAULT now() <<INDEX>>
    }

    entity "candidate_resume_summary" as candidate_resume_summary {
        * id                       : UUID        <<PK>>
        --
        * candidate_id             : UUID        <<FK, INDEX>>
        ..
        * skill_depth              : VARCHAR(30)
        * skill_depth_tags         : TEXT[]
        ..
        * experience_quality       : VARCHAR(30)
        * experience_quality_tags  : TEXT[]
        ..
        * academic_background      : VARCHAR(30)
        * academic_background_tags : TEXT[]
        ..
        * domain_depth             : VARCHAR(30)
        * domain_depth_tags        : TEXT[]
    }
}

' ═══════════════════════════════════════════
' ROW 8 — Candidate History
' ═══════════════════════════════════════════

together {
    entity "candidate_experience" as candidate_experience {
        * id                 : UUID          <<PK>>
        --
        * candidate_id       : UUID          <<FK, INDEX>>
        company              : VARCHAR(200)  <<FK, INDEX, NULL>>
        designation          : VARCHAR(150)  <<FK, INDEX, NULL>>
        industry             : VARCHAR(150)  <<FK, INDEX, NULL>>
        job_title_id         : UUID          <<FK, INDEX, NULL>>
        * start_date         : DATE
        end_date             : DATE          <<NULL>>
        is_current           : BOOLEAN       DEFAULT FALSE
        experience_summary   : TEXT          <<NULL>>
    }

    entity "candidate_education" as candidate_education {
        * id               : UUID          <<PK>>
        --
        * candidate_id     : UUID          <<FK, INDEX>>
        institution_id     : UUID          <<FK, INDEX, NULL>>
        degree             : VARCHAR(150)  <<FK, INDEX, NULL>>
        specialization     : VARCHAR(150)  <<FK, INDEX, NULL>>
        start_year         : SMALLINT      <<NULL>>
        end_year           : SMALLINT      <<NULL>>
        is_highest         : BOOLEAN       DEFAULT FALSE
    }
}

' ═══════════════════════════════════════════
' ROW 8b — Candidate Job & Evaluation
' ═══════════════════════════════════════════

together {
    entity "candidate_job" as candidate_job {
        * id           : UUID          <<PK>>
        --
        * candidate_id : UUID          <<FK, INDEX>>
        * job_id       : UUID          <<FK, INDEX>>
        * is_active    : BOOLEAN       DEFAULT TRUE <<INDEX>>
        status         : UUID          <<FK, INDEX>>
        created_on     : TIMESTAMPTZ   DEFAULT now()
        updated_on     : TIMESTAMPTZ   DEFAULT now()
        created_by     : VARCHAR(20)   <<NULL>>
        updated_by     : VARCHAR(20)   <<NULL>>
        .. UNIQUE (candidate_id, job_id) ..
    }

    entity "candidate_job_evaluation" as candidate_job_evaluation {
        * id                     : UUID          <<PK>>
        --
        * candidate_job_id       : UUID          <<FK, INDEX>>
        jd_overall_match_score   : DECIMAL(5,2)  <<INDEX>>
        skill_match_score        : DECIMAL(5,2)  <<INDEX>>
        domain_match_score       : DECIMAL(5,2)  <<INDEX>>
        jd_exp_relevance_score   : DECIMAL(5,2)  <<INDEX>>
        status                   : UUID          <<FK, INDEX>>
    }
}

entity "candidate_job_interview" as candidate_job_interview {
    * id                  : UUID          <<PK>>
    --
    * candidate_job_id    : UUID          <<FK, INDEX>>
    * round_number        : INT
    ..
    interviewer_name      : VARCHAR(200)  <<NULL>>
    interviewer_email     : VARCHAR(200)  <<NULL>>
    interviewer_type      : VARCHAR(50)   <<NULL>>
    ..
    * scheduled_on        : TIMESTAMPTZ   <<INDEX>>
    mode                  : VARCHAR(50)   <<NULL>>
    status                : UUID          <<FK, INDEX>>
    ..
    questions             : TEXT[]        <<NULL>>
    focus_areas           : TEXT[]        <<NULL>>
    ..
    feedback              : TEXT          <<NULL>>
    score                 : DECIMAL(5,2)  <<NULL>>
    ..
    created_on            : TIMESTAMPTZ   DEFAULT now()
    updated_on            : TIMESTAMPTZ   DEFAULT now()
    created_by            : UUID          <<NULL>>
    updated_by            : UUID          <<NULL>>
}

' ═══════════════════════════════════════════
' ROW 9 — Candidate Misc
' ═══════════════════════════════════════════

together {
    entity "candidate_skill" as candidate_skill {
        * id                : UUID          <<PK>>
        --
        * candidate_id      : UUID          <<FK, INDEX>>
        * skill             : VARCHAR(150)  <<FK, INDEX>>
        proficiency_level   : VARCHAR(50)   <<NULL>>
        years_experience    : DECIMAL(4,1)  <<NULL, CHECK >= 0>>
        last_used_year      : SMALLINT      <<NULL>>
        * validation_status : UUID          <<FK, INDEX>>
        .. UNIQUE (candidate_id, skill) ..
    }

    entity "candidate_document" as candidate_document {
        * id           : UUID         <<PK>>
        --
        * candidate_id : UUID         <<FK, INDEX>>
        * type         : VARCHAR(50)  <<INDEX>>
        * url          : TEXT
        uploaded_on    : TIMESTAMPTZ  DEFAULT now()
    }

    entity "candidate_social_media" as candidate_social_media {
        * id           : UUID        <<PK>>
        --
        * candidate_id : UUID        <<FK, INDEX>>
        * platform     : VARCHAR(50) <<INDEX>>
        * url          : TEXT
        .. UNIQUE (candidate_id, platform) ..
    }
}

' ═══════════════════════════════════════════
' Relationships
' ═══════════════════════════════════════════

' User & Client
status   ||--o{ user            : "user.status → status.id"
industry ||--o{ client          : "client.industry → industry.name"
user     ||--o{ client          : "client.recruiter_id → user.id"
status   ||--o{ client          : "client.status → status.id"

' Job Description
client    ||--o{ job_description : "job_description.client_id → client.id"
job_title ||--o{ job_description : "job_description.job_title_id → job_title.id"
status    ||--o{ job_description : "job_description.status → status.id"

' Reference
institution    ||--o{ institution               : "institution.parent_institution_id → institution.id"
department     ||--o{ department                : "department.parent_department → department.name"
specialization ||--o{ specialization_degree_map : "specialization_degree_map.specialization_id → specialization.id"
degree         ||--o{ specialization_degree_map : "specialization_degree_map.degree_id → degree.id"

' Company & Roles
industry   ||--o{ company     : "company.industry → industry.name"
department ||--o{ job_title   : "job_title.department → department.name"
department ||--o{ designation : "designation.department → department.name"
department ||--o{ skill       : "skill.department → department.name"

' Candidate core
company     ||--o{ candidate  : "candidate.company → company.name"
job_title   ||--o{ candidate  : "candidate.job_title_id → job_title.id"
status      ||--o{ candidate  : "candidate.status_id → status.id"
designation ||--o{ candidate  : "candidate.designation → designation.name"

' Candidate 1:1
candidate ||--|| candidate_preference     : "candidate_preference.candidate_id → candidate.id"
candidate ||--|| candidate_notice_period  : "candidate_notice_period.candidate_id → candidate.id"
candidate ||--|| candidate_score          : "candidate_score.candidate_id → candidate.id"
candidate ||--|| candidate_resume_summary : "candidate_resume_summary.candidate_id → candidate.id"

' Candidate preference refs
job_title ||--o{ candidate_preference    : "candidate_preference.preferred_job_title_id → job_title.id"
company   ||--o{ candidate_notice_period : "candidate_notice_period.company → company.name"

' Candidate history
candidate   ||--o{ candidate_experience  : "candidate_experience.candidate_id → candidate.id"
company     ||--o{ candidate_experience  : "candidate_experience.company → company.name"
designation ||--o{ candidate_experience  : "candidate_experience.designation → designation.name"
industry    ||--o{ candidate_experience  : "candidate_experience.industry → industry.name"
job_title   ||--o{ candidate_experience  : "candidate_experience.job_title_id → job_title.id"

candidate      ||--o{ candidate_education  : "candidate_education.candidate_id → candidate.id"
institution    ||--o{ candidate_education  : "candidate_education.institution_id → institution.id"
degree         ||--o{ candidate_education  : "candidate_education.degree → degree.name"
specialization ||--o{ candidate_education  : "candidate_education.specialization → specialization.name"

' Candidate job interview
candidate_job ||--o{ candidate_job_interview : "candidate_job_interview.candidate_job_id → candidate_job.id"
status        ||--o{ candidate_job_interview : "candidate_job_interview.status → status.id"

' Candidate job & evaluation
candidate       ||--o{ candidate_job            : "candidate_job.candidate_id → candidate.id"
job_description ||--o{ candidate_job            : "candidate_job.job_id → job_description.id"
status          ||--o{ candidate_job            : "candidate_job.status → status.id"

candidate_job ||--|| candidate_job_evaluation : "candidate_job_evaluation.candidate_job_id → candidate_job.id"
status        ||--o{ candidate_job_evaluation  : "candidate_job_evaluation.status → status.id"

' Candidate misc
candidate ||--o{ candidate_skill        : "candidate_skill.candidate_id → candidate.id"
skill     ||--o{ candidate_skill        : "candidate_skill.skill → skill.name"
status    ||--o{ candidate_skill        : "candidate_skill.validation_status → status.id"
candidate ||--o{ candidate_document     : "candidate_document.candidate_id → candidate.id"
candidate ||--o{ candidate_social_media : "candidate_social_media.candidate_id → candidate.id"

@enduml
