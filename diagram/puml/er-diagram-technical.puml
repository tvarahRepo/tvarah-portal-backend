@startuml Tvarah Technical Diagram

top to bottom direction
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 120
skinparam ArrowThickness 1

skinparam entity {
    BorderColor       #555555
    FontSize          13
    FontColor         #1A1A2E
    AttributeFontSize 12
}

skinparam arrow {
    Color     #555555
    FontSize  11
    FontColor #333333
}

' ─────────────────────────────────────────────────────────────
' LEGEND
' ─────────────────────────────────────────────────────────────

legend right
  |= Symbol    |= Meaning              |
  | *          | NOT NULL              |
  | <<PK>>     | Primary Key           |
  | <<FK>>     | Foreign Key           |
  | <<INDEX>>  | Indexed Column        |
  | <<UNIQUE>> | Unique Constraint     |
  | DEFAULT x  | Column Default Value  |
  | CHECK x    | Check Constraint      |
  |||
  | <#D6EAF8> | Core Business         |
  | <#D5F5E3> | Reference / Lookup    |
  | <#FEF9E7> | Status                |
  | <#FDEBD0> | Company               |
  | <#F4ECF7> | Candidate             |
  | <#FDEDEC> | Candidate Analytics   |
  | <#E8F8F5> | Candidate Pipeline    |
  |||
  | ||--o{    | One to Many           |
  | ||--||    | One to One            |
endlegend

' ─────────────────────────────────────────────────────────────
' ROW 1 — Pure Lookup  (no FK dependencies)
' ─────────────────────────────────────────────────────────────

together {
    entity "industry" as industry #D5F5E3 {
        * id               : UUID         <<PK>>
        --
        * name             : VARCHAR(150) <<UNIQUE, INDEX>>
        * sector           : VARCHAR(100) <<INDEX>>
        naics_ref_number   : VARCHAR(100) <<UNIQUE, NULL>>
        aliases            : VARCHAR(255) <<NULL>>
    }

    entity "department" as department #D5F5E3 {
        * id              : UUID         <<PK>>
        --
        * name            : VARCHAR(100) <<UNIQUE, INDEX>>
        * code            : VARCHAR(20)  <<UNIQUE>>
        parent_department : VARCHAR(100) <<FK, INDEX, NULL>>
    }

    entity "degree" as degree #D5F5E3 {
        * id       : UUID          <<PK>>
        --
        * name     : VARCHAR(150)  <<UNIQUE, INDEX>>
        level      : VARCHAR(50)   <<INDEX, NULL>>
        * category : VARCHAR(150)  <<INDEX>>
        * code     : VARCHAR(20)   <<UNIQUE>>
    }

    entity "specialization" as specialization #D5F5E3 {
        * id                : UUID         <<PK>>
        --
        * name              : VARCHAR(150) <<UNIQUE, INDEX>>
        alias               : VARCHAR(100) <<NULL>>
        eligible_degree_id  : UUID         <<FK, INDEX, NULL>>
    }

    entity "institution" as institution #D5F5E3 {
        * id                    : UUID          <<PK>>
        --
        * name                  : VARCHAR(200)  <<INDEX>>
        type                    : VARCHAR(100)  <<INDEX, NULL>>
        parent_institution_id   : UUID          <<FK, INDEX, NULL>>
        alias                   : VARCHAR(200)  <<INDEX, NULL>>
        category                : VARCHAR(100)  <<INDEX, NULL>>
        tier                    : VARCHAR(100)  <<INDEX, NULL>>
        * city                  : VARCHAR(150)  <<INDEX>>
        * state                 : VARCHAR(150)  <<INDEX>>
        country                 : VARCHAR(150)  <<INDEX, NULL>>
        ranking                 : VARCHAR(100)  <<INDEX, NULL>>
        * is_verified           : BOOLEAN       DEFAULT FALSE
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 2 — Lookup tables with FK → Row 1
' ─────────────────────────────────────────────────────────────

together {
    entity "company" as company #FDEBD0 {
        * id                  : UUID         <<PK>>
        --
        * name                : VARCHAR(200) <<UNIQUE, INDEX>>
        name_alias            : VARCHAR(200) <<INDEX, NULL>>
        type                  : VARCHAR(100) <<INDEX, NULL>>
        industry              : VARCHAR(150) <<FK, INDEX, NULL>>
        headquarter_city      : VARCHAR(100) <<NULL>>
        headquarter_state     : VARCHAR(100) <<NULL>>
        headquarter_country   : VARCHAR(100) <<NULL>>
        founded_year          : INT          <<NULL>>
        no_of_employees       : INT          <<NULL>>
        * review_count        : INT          DEFAULT 0
        avg_rating            : DECIMAL(3,1) CHECK 0-5
        * mca_verified             : BOOLEAN      DEFAULT FALSE
        status                     : VARCHAR(100) <<FK, INDEX, NULL>>
        sector                     : VARCHAR(100) <<NULL>>
        company_domain             : VARCHAR(200) <<NULL>>
        candidate_personal_domain  : VARCHAR(200) <<NULL>>
        domain_source              : VARCHAR(100) <<NULL>>
    }

    entity "job_title" as job_title #D5F5E3 {
        * id              : UUID         <<PK>>
        --
        * name            : VARCHAR(150) <<INDEX>>
        * department      : VARCHAR(100) <<FK, INDEX>>
        seniority_level   : VARCHAR(50)  <<INDEX, NULL>>
    }

    entity "designation" as designation #D5F5E3 {
        * id         : UUID          <<PK>>
        --
        * name       : VARCHAR(150)  <<UNIQUE, INDEX>>
        level        : VARCHAR(50)   <<INDEX, NULL>>
        category     : VARCHAR(100)  <<INDEX, NULL>>
        department   : VARCHAR(100)  <<FK, INDEX, NULL>>
        alias        : VARCHAR(150)  <<NULL>>
        * is_active  : BOOLEAN       DEFAULT TRUE
    }

    entity "skill" as skill #D5F5E3 {
        * id            : UUID          <<PK>>
        --
        * name          : VARCHAR(200)  <<INDEX>>
        * category      : VARCHAR(200)  <<INDEX>>
        tier            : VARCHAR(50)   <<INDEX, NULL>>
        * department    : VARCHAR(100)  <<FK, INDEX>>
        * is_technical  : BOOLEAN       DEFAULT FALSE
        * is_verified   : BOOLEAN       DEFAULT FALSE
    }

    entity "specialization_degree_map" as specialization_degree_map #D5F5E3 {
        * id                : UUID <<PK>>
        --
        * specialization_id : UUID <<FK, INDEX>>
        * degree_id         : UUID <<FK, INDEX>>
        .. UNIQUE (specialization_id, degree_id) ..
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 3 — Status tables for Core Business
' ─────────────────────────────────────────────────────────────

together {
    entity "user_status" as user_status #FEF9E7 {
        * name        : VARCHAR(100) <<PK>>
        --
        description   : TEXT         <<NULL>>
    }

    entity "job_status" as job_status #FEF9E7 {
        * name        : VARCHAR(100) <<PK>>
        --
        description   : TEXT         <<NULL>>
    }

    entity "company_status" as company_status #FEF9E7 {
        * name        : VARCHAR(100) <<PK>>
        --
        description   : TEXT         <<NULL>>
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 4 — Core Business  (FK → Rows 1, 2, 3)
' ─────────────────────────────────────────────────────────────

together {
    entity "user" as user #D6EAF8 {
        * id               : UUID          <<PK>>
        --
        first_name         : VARCHAR(150)  <<NULL>>
        last_name          : VARCHAR(150)  <<NULL>>
        * email            : VARCHAR(255)  <<UNIQUE, INDEX>>
        * role             : VARCHAR(50)   <<INDEX>>
        status             : VARCHAR(100)  <<FK, INDEX>>
        * created_on       : TIMESTAMPTZ   DEFAULT now()
        * updated_on       : TIMESTAMPTZ   DEFAULT now()
    }

    entity "user_target" as user_target #D6EAF8 {
        * id               : UUID        <<PK>>
        --
        * user_id          : UUID        <<FK, INDEX>>
        positions_closed   : INT         <<NULL>>
        sourcing           : INT         <<NULL>>
        panel_interview    : INT         <<NULL>>
        client_interview   : INT         <<NULL>>
        * updated_on       : TIMESTAMPTZ DEFAULT now()
    }

    entity "company_user" as company_user #D6EAF8 {
        * id         : UUID        <<PK>>
        --
        * company_id : UUID        <<FK, INDEX>>
        * user_id    : UUID        <<FK, INDEX>>
        * role       : VARCHAR(50) <<INDEX>>
    }

    entity "job_description" as job_description #D6EAF8 {
        * id                       : UUID          <<PK>>
        --
        * code                     : VARCHAR(10)   <<UNIQUE, INDEX>>
        company_id                 : UUID          <<FK, INDEX, NULL>>
        * job_title_id             : UUID          <<FK, INDEX>>
        job_type                   : ENUM          <<Full Time, Part Time, Contract, Internship>>
        job_mode                   : ENUM          <<Onsite, Hybrid, Remote>>
        job_level                  : ENUM          <<Junior, Mid, Senior, Lead, Manager>>
        ..
        * job_description_text     : TEXT
        summary_responsibilities   : TEXT[]        <<NULL>>
        ..
        experience_min_yrs         : DECIMAL(4,1)  <<NULL>>
        experience_max_yrs         : DECIMAL(4,1)  <<NULL>>
        ..
        required_skills            : UUID[]        <<FK→skill, NULL>>
        good_to_have_skills        : UUID[]        <<FK→skill, NULL>>
        ..
        salary_min                 : DECIMAL(10,2) <<NULL>>
        salary_max                 : DECIMAL(10,2) <<NULL>>
        ..
        * total_positions          : INT           DEFAULT 2
        * total_positions_selected : INT           DEFAULT 0
        * total_rounds             : INT           DEFAULT 2
        ..
        * status                   : VARCHAR(100)  <<FK, INDEX>>
        closed_on                  : TIMESTAMPTZ   <<NULL>>
        ..
        * created_on               : TIMESTAMPTZ   DEFAULT now()
        * updated_on               : TIMESTAMPTZ   DEFAULT now()
        created_by                 : VARCHAR(200)  <<NULL>>
        updated_by                 : VARCHAR(200)  <<NULL>>
    }

    entity "job_description_summary" as job_description_summary #D6EAF8 {
        * id                  : UUID          <<PK>>
        --
        * job_description_id  : UUID          <<FK, UNIQUE, INDEX>>
        parsed_jd             : JSONB         <<NULL>>
        enriched_jd           : JSONB         <<NULL>>
        jd_score              : DECIMAL(12,2) <<NULL>>
        non_negotiable_rules  : JSONB         <<NULL>>
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 5 — Status tables for Candidate Domain
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_status" as candidate_status #FEF9E7 {
        * name        : VARCHAR(100) <<PK>>
        --
        description   : TEXT         <<NULL>>
    }

    entity "candidate_job_status" as candidate_job_status #FEF9E7 {
        * name        : VARCHAR(100) <<PK>>
        --
        description   : TEXT         <<NULL>>
    }

    entity "candidate_job_evaluation_status" as candidate_job_evaluation_status #FEF9E7 {
        * name        : VARCHAR(100) <<PK>>
        --
        description   : TEXT         <<NULL>>
    }

    entity "candidate_job_interview_status" as candidate_job_interview_status #FEF9E7 {
        * name        : VARCHAR(100) <<PK>>
        --
        description   : TEXT         <<NULL>>
    }

    entity "skill_validation_status" as skill_validation_status #FEF9E7 {
        * name        : VARCHAR(100) <<PK>>
        --
        description   : TEXT         <<NULL>>
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 6 — Candidate Core  (FK → Rows 1, 2, 4, 5)
' ─────────────────────────────────────────────────────────────

entity "candidate" as candidate #F4ECF7 {
    * id                     : UUID          <<PK>>
    --
    * code                   : VARCHAR(10)   <<UNIQUE, INDEX>>
    * first_name             : VARCHAR(150)
    middle_name              : VARCHAR(150)  <<NULL>>
    * last_name              : VARCHAR(150)
    date_of_birth            : DATE          <<NULL>>
    gender                   : VARCHAR(20)   <<NULL>>
    primary_email            : VARCHAR(255)  <<UNIQUE, INDEX, NULL>>
    secondary_email          : VARCHAR(255)  <<NULL>>
    address                  : TEXT          <<NULL>>
    city                     : VARCHAR(150)  <<NULL>>
    country                  : VARCHAR(150)  <<NULL>>
    country_code             : VARCHAR(10)   <<NULL>>
    primary_phone_number     : VARCHAR(20)   <<INDEX, NULL>>
    secondary_phone_number   : VARCHAR(20)   <<NULL>>
    avatar_color             : VARCHAR(20)   <<NULL>>
    starred                  : BOOLEAN       DEFAULT FALSE
    * status                 : VARCHAR(100)  <<FK, INDEX>>
    * job_title_id           : UUID          <<FK, INDEX>>
    * designation_id         : UUID          <<FK, INDEX>>
    * current_company_id     : UUID          <<FK, INDEX>>
    total_experience         : DECIMAL(12,2) <<INDEX>>
    relevant_experience      : DECIMAL(12,2) <<INDEX>>
    * created_on             : TIMESTAMPTZ   <<INDEX>>
    updated_on               : TIMESTAMPTZ   <<NULL>>
    * created_by             : VARCHAR(200)
    updated_by               : VARCHAR(200)  <<NULL>>
}

' ─────────────────────────────────────────────────────────────
' ROW 7 — Candidate 1:1 Extensions  (FK → Rows 2, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_preference" as candidate_preference #F4ECF7 {
        * id                        : UUID          <<PK>>
        --
        * candidate_id              : UUID          <<FK, UNIQUE, INDEX>>
        current_location            : VARCHAR(100)  <<INDEX, NULL>>
        primary_preferred_location  : VARCHAR(100)  <<NULL>>
        preferred_locations         : TEXT[]        <<NULL>>
        * can_relocate              : BOOLEAN       DEFAULT FALSE
        preferred_job_title_id      : UUID          <<FK, INDEX, NULL>>
        current_ctc                 : DECIMAL(12,2) <<NULL>>
        expected_ctc_min            : DECIMAL(12,2) <<NULL>>
        expected_ctc_max            : DECIMAL(12,2) <<NULL>>
        * ctc_currency              : VARCHAR(5)    DEFAULT 'INR'
        work_mode_preference        : VARCHAR(50)   <<INDEX, NULL>>
        work_authorization          : BOOLEAN       DEFAULT FALSE
        * created_on                : TIMESTAMPTZ   DEFAULT now()
        * updated_on                : TIMESTAMPTZ   DEFAULT now()
        created_by                  : VARCHAR(200)  <<NULL>>
        updated_by                  : VARCHAR(200)  <<NULL>>
    }

    entity "candidate_notice_period" as candidate_notice_period #F4ECF7 {
        * id                     : UUID          <<PK>>
        --
        * candidate_id           : UUID          <<FK, UNIQUE, INDEX>>
        * company_id             : UUID          <<FK, INDEX>>
        * is_in_notice_period    : BOOLEAN       DEFAULT FALSE
        * notice_period_duration : SMALLINT
        resignation_date         : TIMESTAMPTZ   <<INDEX, NULL>>
        earliest_joining_date    : TIMESTAMPTZ   <<INDEX, NULL>>
        last_working_date        : TIMESTAMPTZ   <<INDEX, NULL>>
        * created_on             : TIMESTAMPTZ   DEFAULT now()
        * updated_on             : TIMESTAMPTZ   DEFAULT now()
        created_by               : VARCHAR(200)  <<NULL>>
        updated_by               : VARCHAR(200)  <<NULL>>
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 8 — Candidate Analytics  (FK → Row 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_score" as candidate_score #FDEDEC {
        * id                  : UUID          <<PK>>
        --
        * candidate_id        : UUID          <<FK, INDEX>>
        score                 : DECIMAL(5,2)  <<INDEX, NULL>>
        max_score             : DECIMAL(5,2)  <<NULL>>
        strength              : VARCHAR(50)   <<NULL>>
        feedback_comments     : TEXT          <<NULL>>
        * drop_flag           : BOOLEAN       DEFAULT FALSE
        drop_flag_message     : TEXT          <<NULL>>
        fraud_risk            : VARCHAR(50)   <<INDEX, NULL>>
        * fraud_status        : BOOLEAN       DEFAULT FALSE <<INDEX>>

        * created_on          : TIMESTAMPTZ   DEFAULT now()
        * updated_on          : TIMESTAMPTZ   DEFAULT now() <<INDEX>>
    }

    entity "candidate_score_category_wise" as candidate_score_category_wise #FDEDEC {
        * id                  : UUID          <<PK>>
        --
        * candidate_score_id  : UUID          <<FK, INDEX>>
        * label               : VARCHAR(150)  <<INDEX>>
        score                 : DECIMAL(5,2)  <<NULL>>
        max_score             : DECIMAL(5,2)  <<NULL>>
    }

    entity "candidate_resume_summary" as candidate_resume_summary #FDEDEC {
        * id                       : UUID        <<PK>>
        --
        * candidate_id             : UUID        <<FK, INDEX>>
        ..
        * skill_depth              : VARCHAR(30)
        * skill_depth_tags         : TEXT[]
        ..
        * experience_quality       : VARCHAR(30)
        * experience_quality_tags  : TEXT[]
        ..
        * academic_background      : VARCHAR(30)
        * academic_background_tags : TEXT[]
        ..
        * domain_depth             : VARCHAR(30)
        * domain_depth_tags        : TEXT[]
        ..
        parsed_resume              : JSONB        <<NULL>>
        weakness                   : TEXT[]       <<NULL>>
        strength                   : TEXT[]       <<NULL>>
    }

    entity "candidate_intelligence_insight" as candidate_intelligence_insight #FDEDEC {
        * id                                            : UUID          <<PK>>
        --
        * candidate_id                                  : UUID          <<FK, INDEX>>
        ..
        decision_signal                                 : ENUM          <<Strong, Proceed, Hold, Reject>>
        priority_level                                  : ENUM          <<Low, Moderate, High>>
        decision_rationale                              : TEXT          <<NULL>>
        ..
        candidate_fit_summary_executive_summary         : TEXT          <<NULL>>
        candidate_fit_summary_risk_indicators           : TEXT[]        <<NULL>>
        ..
        education_assessment_credibility_level          : ENUM          <<Weak, Moderate, Strong>>
        institution_verification_status                 : ENUM          <<Verified, Unverified, Suspicious>>
        timeline_integrity                              : ENUM          <<Clean, Minor Gaps, Significant Gaps>>
        education_assessment_executive_summary          : TEXT          <<NULL>>
        education_assessment_hiring_impact              : TEXT          <<NULL>>
        education_assessment_risk_indicators            : JSONB         <<NULL>>
        ..
        experience_credibility_level                    : ENUM          <<Low, Medium, High>>
        employment_stability                            : ENUM          <<Stable, Moderate, Unstable>>
        experience_assessment_executive_summary         : TEXT          <<NULL>>
        experience_assessment_hiring_impact             : TEXT          <<NULL>>
        experience_assessment_risk_indicators           : JSONB         <<NULL>>
        ..
        technical_capability_level                      : ENUM          <<Advanced, Intermediate, Basic, Insufficient>>
        skill_authenticity_level                        : ENUM          <<High, Medium, Low>>
        skills_assessment_executive_summary             : TEXT          <<NULL>>
        skills_assessment_hiring_impact                 : TEXT          <<NULL>>
        skills_assessment_risk_indicators               : JSONB         <<NULL>>
        ..
        domain_assessment_primary_domain                : VARCHAR(100)  <<NULL>>
        domain_impact_level                             : ENUM          <<High, Medium, Low>>
        domain_assessment_executive_summary             : TEXT          <<NULL>>
        domain_assessment_hiring_impact                 : TEXT          <<NULL>>
        domain_assessment_risk_indicators               : JSONB         <<NULL>>
        ..
        education_insights                              : JSONB         <<NULL>>
        experience_insights                             : JSONB         <<NULL>>
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 9 — Candidate History  (FK → Rows 1, 2, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_experience" as candidate_experience #F4ECF7 {
        * id                 : UUID          <<PK>>
        --
        * candidate_id       : UUID          <<FK, INDEX>>
        company_id           : UUID          <<FK, INDEX, NULL>>
        designation_id       : UUID          <<FK, INDEX, NULL>>
        industry_id          : UUID          <<FK, INDEX, NULL>>
        job_title_id         : UUID          <<FK, INDEX, NULL>>
        * start_date         : DATE
        end_date             : DATE          <<NULL>>
        * is_current         : BOOLEAN       DEFAULT FALSE
        role_description     : TEXT          <<NULL>>
        work_location        : VARCHAR(150)  <<NULL>>
        employment_type      : VARCHAR(50)   <<NULL>>
    }

    entity "candidate_education" as candidate_education #F4ECF7 {
        * id                  : UUID          <<PK>>
        --
        * candidate_id        : UUID          <<FK, INDEX>>
        institution_id        : UUID          <<FK, INDEX, NULL>>
        degree_id             : UUID          <<FK, INDEX, NULL>>
        specialization_id     : UUID          <<FK, INDEX, NULL>>
        start_date            : DATE          <<NULL>>
        end_date              : DATE          <<NULL>>
        mode                  : VARCHAR(50)   <<NULL>>
        grade_or_gpa          : VARCHAR(20)   <<NULL>>
        * is_highest          : BOOLEAN       DEFAULT FALSE
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 10 — Candidate Misc  (FK → Rows 2, 5, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_skill" as candidate_skill #F4ECF7 {
        * id                    : UUID          <<PK>>
        --
        * candidate_id          : UUID          <<FK, INDEX>>
        * skill_id              : UUID          <<FK, INDEX>>
        proficiency_level       : VARCHAR(50)   <<NULL>>
        years_experience        : DECIMAL(4,1)  <<NULL, CHECK >= 0>>
        last_used_year          : SMALLINT      <<NULL>>
        * validation_status     : VARCHAR(100)  <<FK, INDEX>>
        is_primary              : BOOLEAN       DEFAULT FALSE
        score                   : DECIMAL(5,2)  <<NULL>>
        .. UNIQUE (candidate_id, skill_id) ..
    }

    entity "candidate_document" as candidate_document #F4ECF7 {
        * id           : UUID         <<PK>>
        --
        * candidate_id : UUID         <<FK, INDEX>>
        * type         : VARCHAR(50)  <<INDEX>>
        * url          : TEXT
        * uploaded_on  : TIMESTAMPTZ  DEFAULT now()
    }

    entity "candidate_social_media" as candidate_social_media #F4ECF7 {
        * id           : UUID        <<PK>>
        --
        * candidate_id : UUID        <<FK, INDEX>>
        * platform     : VARCHAR(50) <<INDEX>>
        * url          : TEXT
        * is_verified  : BOOLEAN     DEFAULT FALSE
        .. UNIQUE (candidate_id, platform) ..
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 11 — Candidate Job  (FK → Rows 4, 5, 6)
' ─────────────────────────────────────────────────────────────

entity "candidate_job" as candidate_job #E8F8F5 {
    * id           : UUID          <<PK>>
    --
    * candidate_id : UUID          <<FK, INDEX>>
    * job_id       : UUID          <<FK, INDEX>>
    status         : VARCHAR(100)  <<FK, INDEX>>
    reason         : TEXT          <<NULL>>
    * created_on   : TIMESTAMPTZ   DEFAULT now()
    * updated_on   : TIMESTAMPTZ   DEFAULT now()
    created_by     : VARCHAR(200)  <<NULL>>
    updated_by     : VARCHAR(200)  <<NULL>>
    .. UNIQUE (candidate_id, job_id) ..
}

' ─────────────────────────────────────────────────────────────
' ROW 12 — Evaluation · Interview  (FK → Rows 5, 11)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_job_evaluation" as candidate_job_evaluation #E8F8F5 {
        * id                     : UUID          <<PK>>
        --
        * candidate_job_id       : UUID          <<FK, INDEX>>
        jd_overall_match_score   : DECIMAL(5,2)  <<INDEX, NULL>>
        skill_match_score        : DECIMAL(5,2)  <<INDEX, NULL>>
        domain_match_score       : DECIMAL(5,2)  <<INDEX, NULL>>
        jd_exp_relevance_score   : DECIMAL(5,2)  <<INDEX, NULL>>
        score                    : DECIMAL(5,2)  <<INDEX, NULL>>
        max_score                : DECIMAL(5,2)  <<NULL>>
        * status                 : VARCHAR(100)  <<FK, INDEX>>
    }

    entity "candidate_job_interview" as candidate_job_interview #E8F8F5 {
        * id                  : UUID          <<PK>>
        --
        * candidate_job_id    : UUID          <<FK, INDEX>>
        * round_number        : INT
        ..
        interviewer_name      : VARCHAR(200)  <<NULL>>
        interviewer_email     : VARCHAR(200)  <<NULL>>
        interviewer_type      : VARCHAR(50)   <<NULL>>
        ..
        * scheduled_on        : TIMESTAMPTZ   <<INDEX>>
        mode                  : VARCHAR(50)   <<NULL>>
        * status              : VARCHAR(100)  <<FK, INDEX>>
        ..
        questions             : TEXT[]        <<NULL>>
        focus_areas           : TEXT[]        <<NULL>>
        ..
        feedback              : TEXT          <<NULL>>
        score                 : DECIMAL(5,2)  <<NULL>>
        max_score             : DECIMAL(5,2)  <<NULL>>
        ..
        * created_on          : TIMESTAMPTZ   DEFAULT now()
        * updated_on          : TIMESTAMPTZ   DEFAULT now()
        created_by            : UUID          <<NULL>>
        updated_by            : UUID          <<NULL>>
    }
}

' ─────────────────────────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────────────────────────

' Row 1 self-references
institution    ||--o{ institution               : "parent_institution_id"
department     ||--o{ department                : "parent_department"
specialization ||--o{ specialization_degree_map : "specialization_id"
degree         ||--o{ specialization_degree_map : "degree_id"
degree         ||--o{ specialization            : "eligible_degree_id"

' Row 1 → Row 2
industry   ||--o{ company     : "industry"
department ||--o{ job_title   : "department"
department ||--o{ designation : "department"
department ||--o{ skill       : "department"

' Row 3 → Row 4
user_status    ||--o{ user            : "status"
user           ||--o{ user_target     : "user_id"
job_status     ||--o{ job_description : "status"
company_status ||--o{ company         : "status"

' Row 2/4 → Row 4
company   ||--o{ company_user    : "company_id"
