@startuml Tvarah Business Diagram

top to bottom direction
skinparam linetype polyline
skinparam nodesep 100
skinparam ranksep 120

skinparam entity {
    BackgroundColor #EEF4FB
    BorderColor     #3A7BD5
    FontSize        13
    FontColor       #1A1A2E
    AttributeFontSize 12
}

skinparam arrow {
    Color           #3A7BD5
    FontSize        12
    FontColor       #1A1A2E
    FontStyle       bold
}

' ═══════════════════════════════════════════
' ROW 0 — User · Client · Job Description
' ═══════════════════════════════════════════

together {
    entity "user" as user {
        id               : uuid
        --
        first_name       : string
        last_name        : string
        email            : string
        keycloak_user_id : uuid
        role             : string
        status           : uuid
        created_on       : timestamp
        updated_on       : timestamp
    }

    entity "client" as client {
        id           : uuid
        --
        name         : string
        industry     : string
        size         : number
        recruiter_id : uuid
        status       : uuid
        created_on   : timestamp
        updated_on   : timestamp
    }

    entity "job_description" as job_description {
        id                       : uuid
        --
        client_id                : uuid
        job_title_id             : uuid
        job_description_text     : string
        ..
        experience_min_yrs       : number
        experience_max_yrs       : number
        ..
        required_skills          : string
        must_have_skills         : string
        good_have_skills         : string
        ..
        salary_min               : number
        salary_max               : number
        ..
        total_positions          : number
        total_positions_selected : number
        total_rounds             : number
        ..
        status                   : uuid
        closed_on                : timestamp
        ..
        jd_score                 : number
        non_negotiable_rules     : string
        ..
        created_on               : timestamp
        updated_on               : timestamp
    }
}

' ═══════════════════════════════════════════
' ROW 1 — Core Reference Tables
' ═══════════════════════════════════════════

together {
    entity "industry" as industry {
        id               : uuid
        --
        name             : string
        sector           : string
        naics_ref_number : string
        aliases          : string
    }

    entity "status" as status {
        id          : uuid
        --
        name        : string
        type        : string
        description : string
    }

    entity "department" as department {
        id                : uuid
        --
        name              : string
        code              : string
        parent_department : string
    }
}

' ═══════════════════════════════════════════
' ROW 2 — Role / Work Reference Tables
' ═══════════════════════════════════════════

together {
    entity "job_title" as job_title {
        id              : uuid
        --
        name            : string
        department      : string
        seniority_level : string
    }

    entity "designation" as designation {
        id         : uuid
        --
        name       : string
        level      : string
        category   : string
        department : string
        alias      : string
        is_active  : boolean
    }

    entity "skill" as skill {
        id           : uuid
        --
        name         : string
        category     : string
        tier         : string
        department   : string
        is_technical : boolean
        is_verified  : boolean
    }
}

' ═══════════════════════════════════════════
' ROW 3 — Education Reference Tables
' ═══════════════════════════════════════════

together {
    entity "institution" as institution {
        id                    : uuid
        --
        name                  : string
        type                  : string
        parent_institution_id : uuid
        alias                 : string
        category              : string
        tier                  : string
        city                  : string
        state                 : string
        ranking               : string
        is_verified           : boolean
    }

    entity "degree" as degree {
        id       : uuid
        --
        name     : string
        level    : string
        category : string
        code     : string
    }

    entity "specialization" as specialization {
        id    : uuid
        --
        name  : string
        alias : string
    }

    entity "specialization_degree_map" as specialization_degree_map {
        id                : uuid
        --
        specialization_id : uuid
        degree_id         : uuid
    }
}

' ═══════════════════════════════════════════
' ROW 4 — Company
' ═══════════════════════════════════════════

entity "company" as company {
    id                  : uuid
    --
    name                : string
    name_alias          : string
    type                : string
    industry            : string
    headquarter_city    : string
    headquarter_state   : string
    headquarter_country : string
    founded_year        : number
    no_of_employees     : number
    review_count        : number
    avg_rating          : number
    mca_verified        : boolean
}

' ═══════════════════════════════════════════
' ROW 5 — Candidate (Core)
' ═══════════════════════════════════════════

entity "candidate" as candidate {
    id                  : uuid
    --
    first_name          : string
    last_name           : string
    email               : string
    address             : string
    city                : string
    country             : string
    phone_number        : string
    whatsapp_number     : string
    total_experience    : number
    relative_experience : number
    designation         : string
    company             : string
    created_on          : timestamp
    updated_on          : timestamp
    created_by          : string
    updated_by          : string
}

' ═══════════════════════════════════════════
' ROW 6 — Candidate 1:1 Extensions
' ═══════════════════════════════════════════

together {
    entity "candidate_preference" as candidate_preference {
        id                         : uuid
        --
        candidate_id               : uuid
        current_location           : string
        primary_preferred_location : string
        preferred_locations        : string
        can_relocate               : boolean
        preferred_job_title_id     : uuid
        current_ctc                : number
        expected_ctc_min           : number
        expected_ctc_max           : number
        ctc_currency               : string
        work_mode_preference       : string
        created_on                 : timestamp
        updated_on                 : timestamp
        created_by                 : string
        updated_by                 : string
    }

    entity "candidate_notice_period" as candidate_notice_period {
        id                     : uuid
        --
        candidate_id           : uuid
        company                : string
        is_in_notice_period    : boolean
        notice_period_duration : number
        resignation_date       : timestamp
        earliest_joining_date  : timestamp
        last_working_date      : timestamp
        created_on             : timestamp
        updated_on             : timestamp
        created_by             : string
        updated_by             : string
    }
}

' ═══════════════════════════════════════════
' ROW 7 — Candidate Scoring & Summary
' ═══════════════════════════════════════════

together {
    entity "candidate_score" as candidate_score {
        id                                    : uuid
        --
        candidate_id                          : uuid
        ..
        overall_score                         : number
        overall_strength                      : string
        ..
        education_quality_score               : number
        institution_credibility_score         : number
        academic_alignment_score              : number
        timeline_integrity_score              : number
        ..
        experience_quality_score              : number
        company_quality_signal_score          : number
        role_progression_score                : number
        experience_sufficiency_score          : number
        ..
        skill_depth_score                     : number
        depth_of_usage_score                  : number
        breadth_tooling_clarity_score         : number
        ..
        domain_depth_score                    : number
        domain_consistency_score              : number
        domain_impact_evidence_score          : number
        domain_language_signal_strength_score : number
        ..
        feedback_comments                     : string
        drop_flag                             : boolean
        fraud_risk                            : string
        fraud_status                          : boolean
        updated_on                            : timestamp
    }

    entity "candidate_resume_summary" as candidate_resume_summary {
        id                        : uuid
        --
        candidate_id              : uuid
        ..
        skill_depth               : string
        skill_depth_tags          : string
        ..
        experience_quality        : string
        experience_quality_tags   : string
        ..
        academic_background       : string
        academic_background_tags  : string
        ..
        domain_depth              : string
        domain_depth_tags         : string
    }
}

' ═══════════════════════════════════════════
' ROW 8 — Candidate History
' ═══════════════════════════════════════════

together {
    entity "candidate_experience" as candidate_experience {
        id                 : uuid
        --
        candidate_id       : uuid
        company            : string
        designation        : string
        industry           : string
        job_title_id       : uuid
        start_date         : timestamp
        end_date           : timestamp
        is_current         : boolean
        experience_summary : string
    }

    entity "candidate_education" as candidate_education {
        id             : uuid
        --
        candidate_id   : uuid
        institution_id : uuid
        degree         : string
        specialization : string
        start_year     : number
        end_year       : number
        is_highest     : boolean
    }
}

' ═══════════════════════════════════════════
' ROW 8b — Candidate Job & Evaluation
' ═══════════════════════════════════════════

together {
    entity "candidate_job" as candidate_job {
        id           : uuid
        --
        candidate_id : uuid
        job_id       : uuid
        is_active    : boolean
        status       : uuid
        created_on   : timestamp
        updated_on   : timestamp
        created_by   : string
        updated_by   : string
    }

    entity "candidate_job_evaluation" as candidate_job_evaluation {
        id                      : uuid
        --
        candidate_job_id        : uuid
        jd_overall_match_score  : number
        skill_match_score       : number
        domain_match_score      : number
        jd_exp_relevance_score  : number
        status                  : uuid
    }
}

entity "candidate_job_interview" as candidate_job_interview {
    id                  : uuid
    --
    candidate_job_id    : uuid
    round_number        : number
    ..
    interviewer_name    : string
    interviewer_email   : string
    interviewer_type    : string
    ..
    scheduled_on        : timestamp
    mode                : string
    status              : uuid
    ..
    questions           : string
    focus_areas         : string
    ..
    feedback            : string
    score               : number
    ..
    created_on          : timestamp
    updated_on          : timestamp
    created_by          : uuid
    updated_by          : uuid
}

' ═══════════════════════════════════════════
' ROW 9 — Candidate Misc
' ═══════════════════════════════════════════

together {
    entity "candidate_skill" as candidate_skill {
        id                : uuid
        --
        candidate_id      : uuid
        skill             : string
        proficiency_level : string
        years_experience  : number
        last_used_year    : number
        validation_status : uuid
    }

    entity "candidate_document" as candidate_document {
        id           : uuid
        --
        candidate_id : uuid
        type         : string
        url          : string
        uploaded_on  : timestamp
    }

    entity "candidate_social_media" as candidate_social_media {
        id           : uuid
        --
        candidate_id : uuid
        platform     : string
        url          : string
    }
}

' ═══════════════════════════════════════════
' Relationships
' ═══════════════════════════════════════════

' User & Client
status   ||--o{ user             : "assigned_status"
industry ||--o{ client           : "categorised_as"
user     ||--o{ client           : "managed by"
status   ||--o{ client           : "assigned_status"

' Job Description
client    ||--o{ job_description  : "raised_by"
job_title ||--o{ job_description  : "titled_as"
status    ||--o{ job_description  : "assigned_status"

' Reference
institution    ||--o{ institution               : "has_branch"
department     ||--o{ department                : "has_sub_department"
specialization ||--o{ specialization_degree_map : "mapped_to"
degree         ||--o{ specialization_degree_map : "mapped_to"

' Company & Roles
industry   ||--o{ company      : "categorised_as"
department ||--o{ job_title    : "owns"
department ||--o{ designation  : "owns"
department ||--o{ skill        : "owns"

' Candidate core
company     ||--o{ candidate   : "currently_at"
job_title   ||--o{ candidate   : "applies_to"
status      ||--o{ candidate   : "tracked_by"
designation ||--o{ candidate   : "designated_as"

' Candidate 1:1
candidate ||--|| candidate_preference     : "has_preference"
candidate ||--|| candidate_notice_period  : "has_notice_period"
candidate ||--|| candidate_score          : "scored_as"
candidate ||--|| candidate_resume_summary : "summarised_as"

' Candidate preference refs
job_title ||--o{ candidate_preference    : "prefers_job_title"
company   ||--o{ candidate_notice_period : "serving_notice_at"

' Candidate history
candidate   ||--o{ candidate_experience  : "has_experience"
company     ||--o{ candidate_experience  : "worked_at"
designation ||--o{ candidate_experience  : "held"
industry    ||--o{ candidate_experience  : "worked_in"
job_title   ||--o{ candidate_experience  : "titled_as"

candidate      ||--o{ candidate_education  : "has_education"
institution    ||--o{ candidate_education  : "studied_at"
degree         ||--o{ candidate_education  : "holds_degree"
specialization ||--o{ candidate_education  : "specialised_in"

' Candidate job interview
candidate_job ||--o{ candidate_job_interview : "has_interview_round"
status        ||--o{ candidate_job_interview : "assigned_status"

' Candidate job & evaluation
candidate       ||--o{ candidate_job            : "applied_to"
job_description ||--o{ candidate_job            : "has_candidate"
status          ||--o{ candidate_job            : "assigned_status"

candidate_job ||--|| candidate_job_evaluation : "evaluated_as"
status        ||--o{ candidate_job_evaluation  : "assigned_status"

' Candidate misc
candidate ||--o{ candidate_skill        : "has"
skill     ||--o{ candidate_skill        : "typed_as"
status    ||--o{ candidate_skill        : "validated_as"
candidate ||--o{ candidate_document     : "has_document"
candidate ||--o{ candidate_social_media : "has_social_media"

@enduml
