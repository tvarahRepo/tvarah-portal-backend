@startuml Tvarah Business Diagram

top to bottom direction
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

skinparam entity {
    BorderColor       #555555
    FontSize          13
    FontColor         #1A1A2E
    AttributeFontSize 12
}

skinparam arrow {
    Color     #555555
    FontSize  11
    FontColor #333333
}

' ─────────────────────────────────────────────────────────────
' LEGEND
' ─────────────────────────────────────────────────────────────

legend right
  |= Color      |= Domain            |
  | <#D6EAF8>  | Core Business       |
  | <#D5F5E3>  | Reference / Lookup  |
  | <#FEF9E7>  | Status              |
  | <#FDEBD0>  | Company             |
  | <#F4ECF7>  | Candidate           |
  | <#FDEDEC>  | Candidate Analytics |
  | <#E8F8F5>  | Candidate Pipeline  |
  |||
  | ||--o{     | One to Many         |
  | ||--||     | One to One          |
endlegend

' ─────────────────────────────────────────────────────────────
' ROW 1 — Pure Lookup  (no FK dependencies)
' ─────────────────────────────────────────────────────────────

together {
    entity "industry" as industry #D5F5E3 {
        id               : uuid
        --
        name             : string
        sector           : string
        naics_ref_number : string
        aliases          : string
    }

    entity "department" as department #D5F5E3 {
        id                : uuid
        --
        name              : string
        code              : string
        parent_department : string
    }

    entity "degree" as degree #D5F5E3 {
        id       : uuid
        --
        name     : string
        level    : string
        category : string
        code     : string
    }

    entity "specialization" as specialization #D5F5E3 {
        id    : uuid
        --
        name  : string
        alias : string
    }

    entity "institution" as institution #D5F5E3 {
        id                    : uuid
        --
        name                  : string
        type                  : string
        parent_institution_id : uuid
        alias                 : string
        category              : string
        tier                  : string
        city                  : string
        state                 : string
        ranking               : string
        is_verified           : boolean
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 2 — Lookup tables with FK → Row 1
' ─────────────────────────────────────────────────────────────

together {
    entity "company" as company #FDEBD0 {
        id                  : uuid
        --
        name                : string
        name_alias          : string
        type                : string
        industry            : string
        headquarter_city    : string
        headquarter_state   : string
        headquarter_country : string
        founded_year        : number
        no_of_employees     : number
        review_count        : number
        avg_rating          : number
        mca_verified        : boolean
    }

    entity "job_title" as job_title #D5F5E3 {
        id              : uuid
        --
        name            : string
        department      : string
        seniority_level : string
    }

    entity "designation" as designation #D5F5E3 {
        id         : uuid
        --
        name       : string
        level      : string
        category   : string
        department : string
        alias      : string
        is_active  : boolean
    }

    entity "skill" as skill #D5F5E3 {
        id           : uuid
        --
        name         : string
        category     : string
        tier         : string
        department   : string
        is_technical : boolean
        is_verified  : boolean
    }

    entity "specialization_degree_map" as specialization_degree_map #D5F5E3 {
        id                : uuid
        --
        specialization_id : uuid
        degree_id         : uuid
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 3 — Status tables for Core Business
' ─────────────────────────────────────────────────────────────

together {
    entity "user_status" as user_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "client_status" as client_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "job_status" as job_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 4 — Core Business  (FK → Rows 1, 2, 3)
' ─────────────────────────────────────────────────────────────

together {
    entity "user" as user #D6EAF8 {
        id               : uuid
        --
        first_name       : string
        last_name        : string
        email            : string
        keycloak_user_id : uuid
        role             : string
        status           : string
        created_on       : timestamp
        updated_on       : timestamp
    }

    entity "client" as client #D6EAF8 {
        id           : uuid
        --
        name         : string
        industry     : string
        size         : number
        recruiter_id : uuid
        status       : string
        created_on   : timestamp
        updated_on   : timestamp
    }

    entity "job_description" as job_description #D6EAF8 {
        id                       : uuid
        --
        client_id                : uuid
        job_title_id             : uuid
        job_description_text     : string
        ..
        experience_min_yrs       : number
        experience_max_yrs       : number
        ..
        required_skills          : string
        must_have_skills         : string
        good_have_skills         : string
        ..
        salary_min               : number
        salary_max               : number
        ..
        total_positions          : number
        total_positions_selected : number
        total_rounds             : number
        ..
        status                   : string
        closed_on                : timestamp
        jd_score                 : number
        non_negotiable_rules     : string
        ..
        created_on               : timestamp
        updated_on               : timestamp
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 5 — Status tables for Candidate Domain
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_status" as candidate_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "candidate_job_status" as candidate_job_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "candidate_job_evaluation_status" as candidate_job_evaluation_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "candidate_job_interview_status" as candidate_job_interview_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "skill_validation_status" as skill_validation_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 6 — Candidate Core  (FK → Rows 1, 2, 4, 5)
' ─────────────────────────────────────────────────────────────

entity "candidate" as candidate #F4ECF7 {
    id                  : uuid
    --
    first_name          : string
    last_name           : string
    email               : string
    address             : string
    city                : string
    country             : string
    phone_number        : string
    whatsapp_number     : string
    status              : string
    total_experience    : number
    relative_experience : number
    designation         : string
    company             : string
    created_on          : timestamp
    updated_on          : timestamp
    created_by          : string
    updated_by          : string
}

' ─────────────────────────────────────────────────────────────
' ROW 7 — Candidate 1:1 Extensions  (FK → Rows 2, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_preference" as candidate_preference #F4ECF7 {
        id                         : uuid
        --
        candidate_id               : uuid
        current_location           : string
        primary_preferred_location : string
        preferred_locations        : string
        can_relocate               : boolean
        preferred_job_title_id     : uuid
        current_ctc                : number
        expected_ctc_min           : number
        expected_ctc_max           : number
        ctc_currency               : string
        work_mode_preference       : string
        created_on                 : timestamp
        updated_on                 : timestamp
        created_by                 : string
        updated_by                 : string
    }

    entity "candidate_notice_period" as candidate_notice_period #F4ECF7 {
        id                     : uuid
        --
        candidate_id           : uuid
        company                : string
        is_in_notice_period    : boolean
        notice_period_duration : number
        resignation_date       : timestamp
        earliest_joining_date  : timestamp
        last_working_date      : timestamp
        created_on             : timestamp
        updated_on             : timestamp
        created_by             : string
        updated_by             : string
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 8 — Candidate Analytics  (FK → Row 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_score" as candidate_score #FDEDEC {
        id                                    : uuid
        --
        candidate_id                          : uuid
        ..
        overall_score                         : number
        overall_strength                      : string
        ..
        education_quality_score               : number
        institution_credibility_score         : number
        academic_alignment_score              : number
        timeline_integrity_score              : number
        ..
        experience_quality_score              : number
        company_quality_signal_score          : number
        role_progression_score                : number
        experience_sufficiency_score          : number
        ..
        skill_depth_score                     : number
        depth_of_usage_score                  : number
        breadth_tooling_clarity_score         : number
        ..
        domain_depth_score                    : number
        domain_consistency_score              : number
        domain_impact_evidence_score          : number
        domain_language_signal_strength_score : number
        ..
        feedback_comments                     : string
        drop_flag                             : boolean
        fraud_risk                            : string
        fraud_status                          : boolean
        updated_on                            : timestamp
    }

    entity "candidate_resume_summary" as candidate_resume_summary #FDEDEC {
        id                        : uuid
        --
        candidate_id              : uuid
        ..
        skill_depth               : string
        skill_depth_tags          : string
        ..
        experience_quality        : string
        experience_quality_tags   : string
        ..
        academic_background       : string
        academic_background_tags  : string
        ..
        domain_depth              : string
        domain_depth_tags         : string
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 9 — Candidate History  (FK → Rows 1, 2, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_experience" as candidate_experience #F4ECF7 {
        id                 : uuid
        --
        candidate_id       : uuid
        company            : string
        designation        : string
        industry           : string
        job_title_id       : uuid
        start_date         : timestamp
        end_date           : timestamp
        is_current         : boolean
        experience_summary : string
    }

    entity "candidate_education" as candidate_education #F4ECF7 {
        id             : uuid
        --
        candidate_id   : uuid
        institution_id : uuid
        degree         : string
        specialization : string
        start_year     : number
        end_year       : number
        is_highest     : boolean
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 10 — Candidate Misc  (FK → Rows 2, 5, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_skill" as candidate_skill #F4ECF7 {
        id                : uuid
        --
        candidate_id      : uuid
        skill             : string
        proficiency_level : string
        years_experience  : number
        last_used_year    : number
        validation_status : string
    }

    entity "candidate_document" as candidate_document #F4ECF7 {
        id           : uuid
        --
        candidate_id : uuid
        type         : string
        url          : string
        uploaded_on  : timestamp
    }

    entity "candidate_social_media" as candidate_social_media #F4ECF7 {
        id           : uuid
        --
        candidate_id : uuid
        platform     : string
        url          : string
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 11 — Candidate Job  (FK → Rows 4, 5, 6)
' ─────────────────────────────────────────────────────────────

entity "candidate_job" as candidate_job #E8F8F5 {
    id           : uuid
    --
    candidate_id : uuid
    job_id       : uuid
    is_active    : boolean
    status       : string
    created_on   : timestamp
    updated_on   : timestamp
    created_by   : string
    updated_by   : string
}

' ─────────────────────────────────────────────────────────────
' ROW 12 — Evaluation · Interview  (FK → Rows 5, 11)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_job_evaluation" as candidate_job_evaluation #E8F8F5 {
        id                      : uuid
        --
        candidate_job_id        : uuid
        jd_overall_match_score  : number
        skill_match_score       : number
        domain_match_score      : number
        jd_exp_relevance_score  : number
        status                  : string
    }

    entity "candidate_job_interview" as candidate_job_interview #E8F8F5 {
        id                : uuid
        --
        candidate_job_id  : uuid
        round_number      : number
        ..
        interviewer_name  : string
        interviewer_email : string
        interviewer_type  : string
        ..
        scheduled_on      : timestamp
        mode              : string
        status            : string
        ..
        questions         : string
        focus_areas       : string
        ..
        feedback          : string
        score             : number
        ..
        created_on        : timestamp
        updated_on        : timestamp
        created_by        : uuid
        updated_by        : uuid
    }
}

' ─────────────────────────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────────────────────────

' Row 1 self-references
institution    ||--o{ institution               : "branch of"
department     ||--o{ department                : "sub-dept of"
specialization ||--o{ specialization_degree_map : "specialization"
degree         ||--o{ specialization_degree_map : "degree"

' Row 1 → Row 2
industry   ||--o{ company     : "industry"
department ||--o{ job_title   : "department"
department ||--o{ designation : "department"
department ||--o{ skill       : "department"

' Row 3 → Row 4  (status → entity)
user_status   ||--o{ user            : "status"
client_status ||--o{ client          : "status"
job_status    ||--o{ job_description : "status"

' Row 2/4 → Row 4
industry  ||--o{ client          : "industry"
user      ||--o{ client          : "recruiter"
client    ||--o{ job_description : "client"
job_title ||--o{ job_description : "title"

' Row 5 → Row 6  (status → candidate)
candidate_status ||--o{ candidate : "status"

' Row 2 → Row 6
company     ||--o{ candidate : "current company"
job_title   ||--o{ candidate : "current title"
designation ||--o{ candidate : "designation"

' Row 6 → Row 7  (candidate → extensions)
candidate ||--|| candidate_preference    : "preferences"
candidate ||--|| candidate_notice_period : "notice period"

' Row 2 → Row 7
job_title ||--o{ candidate_preference    : "preferred title"
company   ||--o{ candidate_notice_period : "notice at"

' Row 6 → Row 8  (candidate → analytics)
candidate ||--|| candidate_score          : "score"
candidate ||--|| candidate_resume_summary : "summary"

' Row 6 → Row 9  (candidate → history)
candidate   ||--o{ candidate_experience : "experience"
candidate   ||--o{ candidate_education  : "education"

' Row 1/2 → Row 9
company     ||--o{ candidate_experience : "company"
designation ||--o{ candidate_experience : "designation"
industry    ||--o{ candidate_experience : "industry"
job_title   ||--o{ candidate_experience : "title"
institution ||--o{ candidate_education  : "institution"
degree      ||--o{ candidate_education  : "degree"
specialization ||--o{ candidate_education : "specialization"

' Row 2/5/6 → Row 10  (candidate → misc)
candidate               ||--o{ candidate_skill        : "skills"
skill                   ||--o{ candidate_skill        : "skill ref"
skill_validation_status ||--o{ candidate_skill        : "validation"
candidate               ||--o{ candidate_document     : "documents"
candidate               ||--o{ candidate_social_media : "social links"

' Row 4/5/6 → Row 11  (candidate + job → candidate_job)
candidate            ||--o{ candidate_job : "application"
job_description      ||--o{ candidate_job : "job"
candidate_job_status ||--o{ candidate_job : "status"

' Row 5/11 → Row 12  (candidate_job → evaluation & interview)
candidate_job                   ||--|| candidate_job_evaluation : "evaluation"
candidate_job_evaluation_status ||--o{ candidate_job_evaluation : "status"

candidate_job                  ||--o{ candidate_job_interview : "interview"
candidate_job_interview_status ||--o{ candidate_job_interview : "status"

@enduml
