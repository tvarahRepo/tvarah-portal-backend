@startuml Tvarah Business Diagram

top to bottom direction
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 120
skinparam ArrowThickness 1

skinparam entity {
    BorderColor       #555555
    FontSize          13
    FontColor         #1A1A2E
    AttributeFontSize 12
}

skinparam arrow {
    Color     #555555
    FontSize  11
    FontColor #333333
}

' ─────────────────────────────────────────────────────────────
' LEGEND
' ─────────────────────────────────────────────────────────────

legend right
  |= Color      |= Domain            |
  | <#D6EAF8>  | Core Business       |
  | <#D5F5E3>  | Reference / Lookup  |
  | <#FEF9E7>  | Status              |
  | <#FDEBD0>  | Company             |
  | <#F4ECF7>  | Candidate           |
  | <#FDEDEC>  | Candidate Analytics |
  | <#E8F8F5>  | Candidate Pipeline  |
  |||
  | ||--o{     | One to Many         |
  | ||--||     | One to One          |
endlegend

' ─────────────────────────────────────────────────────────────
' ROW 1 — Pure Lookup  (no FK dependencies)
' ─────────────────────────────────────────────────────────────

together {
    entity "industry" as industry #D5F5E3 {
        id               : uuid
        --
        name             : string
        sector           : string
        naics_ref_number : string
        aliases          : string
    }

    entity "department" as department #D5F5E3 {
        id                : uuid
        --
        name              : string
        code              : string
        parent_department : string
    }

    entity "degree" as degree #D5F5E3 {
        id       : uuid
        --
        name     : string
        level    : string
        category : string
        code     : string
    }

    entity "specialization" as specialization #D5F5E3 {
        id                 : uuid
        --
        name               : string
        alias              : string
        eligible_degree_id : uuid
    }

    entity "institution" as institution #D5F5E3 {
        id                    : uuid
        --
        name                  : string
        type                  : string
        parent_institution_id : uuid
        alias                 : string
        category              : string
        tier                  : string
        city                  : string
        state                 : string
        country               : string
        ranking               : string
        is_verified           : boolean
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 2 — Lookup tables with FK → Row 1
' ─────────────────────────────────────────────────────────────

together {
    entity "company" as company #FDEBD0 {
        id                        : uuid
        --
        name                      : string
        name_alias                : string
        type                      : string
        industry                  : string
        headquarter_city          : string
        headquarter_state         : string
        headquarter_country       : string
        founded_year              : number
        no_of_employees           : number
        review_count              : number
        avg_rating                : number
        mca_verified              : boolean
        status                    : string
        sector                    : string
        company_domain            : string
        candidate_personal_domain : string
        domain_source             : string
        logo                      : bytes
        logo_content_type         : string
    }

    entity "job_title" as job_title #D5F5E3 {
        id              : uuid
        --
        name            : string
        department      : string
        seniority_level : string
    }

    entity "designation" as designation #D5F5E3 {
        id         : uuid
        --
        name       : string
        level      : string
        category   : string
        department : string
        alias      : string
        is_active  : boolean
    }

    entity "skill" as skill #D5F5E3 {
        id           : uuid
        --
        name         : string
        category     : string
        tier         : string
        department   : string
        is_technical : boolean
        is_verified  : boolean
    }

    entity "specialization_degree_map" as specialization_degree_map #D5F5E3 {
        id                : uuid
        --
        specialization_id : uuid
        degree_id         : uuid
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 3 — Status / Role Reference tables
' ─────────────────────────────────────────────────────────────

together {
    entity "user_status" as user_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
        ..
        ' Values: Draft, Pending, Active,
        ' Inactive, Suspended
    }

    entity "user_role" as user_role #FEF9E7 {
        name        : string  <<PK>>
        --
        type        : string
        description : string
        ..
        ' INTERNAL: Admin, Management,
        '   Account Manager, Recruiter,
        '   Panel, Sales and BD, Candidate
        ' EXTERNAL: Client-TA Head,
        '   Client-TA Associate,
        '   Client-Hiring Manager,
        '   Client-Director
    }

    entity "job_status" as job_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "company_status" as company_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 4 — Core Business  (FK → Rows 1, 2, 3)
' ─────────────────────────────────────────────────────────────

together {
    entity "user" as user #D6EAF8 {
        id                  : uuid
        --
        keycloak_user_id    : string
        email               : string
        first_name          : string
        last_name           : string
        phone_number        : string
        department          : string
        location            : string
        role                : string
        status              : string
        avatar              : bytes
        avatar_content_type : string
        created_on          : timestamp
        updated_on          : timestamp
        ..
        ' Draft users: no keycloak_user_id
    }

    entity "user_target" as user_target #D6EAF8 {
        id               : uuid
        --
        user_id          : uuid
        positions_closed : number
        sourcing         : number
        panel_interview  : number
        client_interview : number
        updated_on       : timestamp
    }

    entity "company_user" as company_user #D6EAF8 {
        id         : uuid
        --
        company_id : uuid
        user_id    : uuid
        role       : string
    }

    entity "job_description" as job_description #D6EAF8 {
        id                       : uuid
        --
        code                     : string
        company_id               : uuid
        job_title_id             : uuid
        job_type                 : enum
        job_mode                 : enum
        job_level                : enum
        ..
        job_description_text     : string
        summary_responsibilities : list
        ..
        experience_min_yrs       : number
        experience_max_yrs       : number
        ..
        required_skills          : uuid list
        good_to_have_skills      : uuid list
        ..
        salary_min               : number
        salary_max               : number
        ..
        total_positions          : number
        total_positions_selected : number
        total_rounds             : number
        ..
        status                   : string
        closed_on                : timestamp
        ..
        created_on               : timestamp
        updated_on               : timestamp
        created_by               : string
        updated_by               : string
    }

    entity "job_description_summary" as job_description_summary #D6EAF8 {
        id                       : uuid
        --
        job_description_id       : uuid
        parsed_jd                : jsonb
        enriched_jd              : jsonb
        jd_score                 : number
        non_negotiable_rules     : jsonb
        ..
        scorecard_role_clarity   : number
        scorecard_tech_specificity : number
        consulting_vs_product    : string
        experience_inflation     : string
        missing_screening        : list
        compensation_signal      : string
        ..
        ml_verdict               : string
        judge_results            : jsonb
        ml_reflection_loop       : number
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 5 — Status tables for Candidate Domain
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_status" as candidate_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "candidate_job_status" as candidate_job_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "candidate_job_evaluation_status" as candidate_job_evaluation_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "candidate_job_interview_status" as candidate_job_interview_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }

    entity "skill_validation_status" as skill_validation_status #FEF9E7 {
        name        : string  <<PK>>
        --
        description : string
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 6 — Candidate Core  (FK → Rows 1, 2, 4, 5)
' ─────────────────────────────────────────────────────────────

entity "candidate" as candidate #F4ECF7 {
    id                     : uuid
    --
    code                   : string
    first_name             : string
    middle_name            : string
    last_name              : string
    date_of_birth          : date
    gender                 : string
    primary_email          : string
    secondary_email        : string
    address                : string
    city                   : string
    country                : string
    country_code           : string
    primary_phone_number   : string
    secondary_phone_number : string
    avatar_color           : string
    starred                : boolean
    status                 : string
    job_title_id           : uuid
    designation_id         : uuid
    current_company_id     : uuid
    total_experience       : number
    relevant_experience    : number
    created_on             : timestamp
    updated_on             : timestamp
    created_by             : string
    updated_by             : string
}

' ─────────────────────────────────────────────────────────────
' ROW 7 — Candidate 1:1 Extensions  (FK → Rows 2, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_preference" as candidate_preference #F4ECF7 {
        id                         : uuid
        --
        candidate_id               : uuid
        current_location           : string
        primary_preferred_location : string
        preferred_locations        : list
        can_relocate               : boolean
        preferred_job_title_id     : uuid
        current_ctc                : number
        expected_ctc_min           : number
        expected_ctc_max           : number
        ctc_currency               : string
        work_mode_preference       : string
        work_authorization         : boolean
        created_on                 : timestamp
        updated_on                 : timestamp
    }

    entity "candidate_notice_period" as candidate_notice_period #F4ECF7 {
        id                     : uuid
        --
        candidate_id           : uuid
        company_id             : uuid
        is_in_notice_period    : boolean
        notice_period_duration : number
        resignation_date       : timestamp
        earliest_joining_date  : timestamp
        last_working_date      : timestamp
        created_on             : timestamp
        updated_on             : timestamp
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 8 — Candidate Analytics  (FK → Row 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_score" as candidate_score #FDEDEC {
        id                : uuid
        --
        candidate_id      : uuid
        score             : number
        max_score         : number
        strength          : string
        feedback_comments : string
        drop_flag         : boolean
        drop_flag_message : string
        fraud_risk        : string
        fraud_status      : boolean
        created_on        : timestamp
        updated_on        : timestamp
    }

    entity "candidate_score_category_wise" as candidate_score_category_wise #FDEDEC {
        id                 : uuid
        --
        candidate_score_id : uuid
        label              : string
        score              : number
        max_score          : number
    }

    entity "candidate_resume_summary" as candidate_resume_summary #FDEDEC {
        id                        : uuid
        --
        candidate_id              : uuid
        ..
        skill_depth               : string
        skill_depth_tags          : list
        ..
        experience_quality        : string
        experience_quality_tags   : list
        ..
        academic_background       : string
        academic_background_tags  : list
        ..
        domain_depth              : string
        domain_depth_tags         : list
        parsed_resume             : jsonb
        weakness                  : list
        strength                  : list
    }

    entity "candidate_intelligence_insight" as candidate_intelligence_insight #FDEDEC {
        id                                              : uuid
        --
        candidate_id                                    : uuid
        decision_signal                                 : enum
        priority_level                                  : enum
        decision_rationale                              : string
        candidate_fit_summary_executive_summary         : string
        candidate_fit_summary_risk_indicators           : list
        education_assessment_credibility_level          : enum
        institution_verification_status                 : enum
        timeline_integrity                              : enum
        education_assessment_executive_summary          : string
        education_assessment_hiring_impact              : string
        education_assessment_risk_indicators            : jsonb
        experience_credibility_level                    : enum
        employment_stability                            : enum
        experience_assessment_executive_summary         : string
        experience_assessment_hiring_impact             : string
        experience_assessment_risk_indicators           : jsonb
        technical_capability_level                      : enum
        skill_authenticity_level                        : enum
        skills_assessment_executive_summary             : string
        skills_assessment_hiring_impact                 : string
        skills_assessment_risk_indicators               : jsonb
        domain_assessment_primary_domain                : string
        domain_impact_level                             : enum
        domain_assessment_executive_summary             : string
        domain_assessment_hiring_impact                 : string
        domain_assessment_risk_indicators               : jsonb
        education_insights                              : jsonb
        experience_insights                             : jsonb
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 9 — Candidate History  (FK → Rows 1, 2, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_experience" as candidate_experience #F4ECF7 {
        id               : uuid
        --
        candidate_id     : uuid
        company_id       : uuid
        designation_id   : uuid
        industry_id      : uuid
        job_title_id     : uuid
        start_date       : date
        end_date         : date
        is_current       : boolean
        role_description : string
        work_location    : string
        employment_type  : string
    }

    entity "candidate_education" as candidate_education #F4ECF7 {
        id                : uuid
        --
        candidate_id      : uuid
        institution_id    : uuid
        degree_id         : uuid
        specialization_id : uuid
        start_date        : date
        end_date          : date
        mode              : string
        grade_or_gpa      : string
        is_highest        : boolean
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 10 — Candidate Misc  (FK → Rows 2, 5, 6)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_skill" as candidate_skill #F4ECF7 {
        id                : uuid
        --
        candidate_id      : uuid
        skill_id          : uuid
        proficiency_level : string
        years_experience  : number
        last_used_year    : number
        validation_status : string
        is_primary        : boolean
        score             : number
    }

    entity "candidate_document" as candidate_document #F4ECF7 {
        id           : uuid
        --
        candidate_id : uuid
        type         : string
        url          : string
        uploaded_on  : timestamp
    }

    entity "candidate_social_media" as candidate_social_media #F4ECF7 {
        id           : uuid
        --
        candidate_id : uuid
        platform     : string
        url          : string
        is_verified  : boolean
    }
}

' ─────────────────────────────────────────────────────────────
' ROW 11 — Candidate Job  (FK → Rows 4, 5, 6)
' ─────────────────────────────────────────────────────────────

entity "candidate_job" as candidate_job #E8F8F5 {
    id           : uuid
    --
    candidate_id : uuid
    job_id       : uuid
    status       : string
    reason       : string
    created_on   : timestamp
    updated_on   : timestamp
    created_by   : string
    updated_by   : string
}

' ─────────────────────────────────────────────────────────────
' ROW 12 — Evaluation · Interview  (FK → Rows 5, 11)
' ─────────────────────────────────────────────────────────────

together {
    entity "candidate_job_evaluation" as candidate_job_evaluation #E8F8F5 {
        id                      : uuid
        --
        candidate_job_id        : uuid
        jd_overall_match_score  : number
        skill_match_score       : number
        domain_match_score      : number
        jd_exp_relevance_score  : number
        score                   : number
        max_score               : number
        status                  : string
    }

    entity "candidate_job_interview" as candidate_job_interview #E8F8F5 {
        id                : uuid
        --
        candidate_job_id  : uuid
        round_number      : number
        ..
        interviewer_name  : string
        interviewer_email : string
        interviewer_type  : string
        ..
        scheduled_on      : timestamp
        mode              : string
        status            : string
        ..
        questions         : list
        focus_areas       : list
        ..
        feedback          : string
        score             : number
        max_score         : number
        ..
        created_on        : timestamp
        updated_on        : timestamp
        created_by        : uuid
        updated_by        : uuid
    }
}

' ─────────────────────────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────────────────────────

' Row 1 self-references
institution    ||--o{ institution               : "branch of"
department     ||--o{ department                : "sub-dept of"
specialization ||--o{ specialization_degree_map : "specialization"
degree         ||--o{ specialization_degree_map : "degree"
degree         ||--o{ specialization            : "eligible_degree_id"

' Row 1 → Row 2
industry   ||--o{ company     : "industry"
department ||--o{ job_title   : "department"
department ||--o{ designation : "department"
department ||--o{ skill       : "department"

' Row 3 → Row 4
user_status    ||--o{ user            : "status"
user_role      ||--o{ user            : "role (informational)"
user_role      ||--o{ company_user    : "role (informational)"
user           ||--o{ user_target     : "user_id"
job_status     ||--o{ job_description : "status"
company_status ||--o{ company         : "status"

' Row 2/4 → Row 4
company         ||--o{ company_user           : "company_id"
user            ||--o{ company_user           : "user_id"
company         ||--o{ job_description        : "company_id"
job_title       ||--o{ job_description        : "title"
job_description ||--|| job_description_summary : "job_description_id"

' Row 5 → Row 6
candidate_status ||--o{ candidate : "status"

' Row 2 → Row 6
company     ||--o{ candidate : "current_company_id"
job_title   ||--o{ candidate : "job_title_id"
designation ||--o{ candidate : "designation_id"

' Row 6 → Row 7
candidate ||--|| candidate_preference    : "preferences"
candidate ||--|| candidate_notice_period : "notice period"

' Row 2 → Row 7
job_title ||--o{ candidate_preference    : "preferred title"
company   ||--o{ candidate_notice_period : "company_id"

' Row 6 → Row 8
candidate ||--|| candidate_resume_summary       : "summary"
candidate ||--o{ candidate_intelligence_insight : "candidate_id"

' Row 6 → Row 8 (score)
candidate       ||--|| candidate_score               : "score"
candidate_score ||--o{ candidate_score_category_wise : "category scores"

' Row 6 → Row 9
candidate ||--o{ candidate_experience : "experience"
candidate ||--o{ candidate_education  : "education"

' Row 1/2 → Row 9
company        ||--o{ candidate_experience : "company_id"
designation    ||--o{ candidate_experience : "designation_id"
industry       ||--o{ candidate_experience : "industry_id"
job_title      ||--o{ candidate_experience : "title"
institution    ||--o{ candidate_education  : "institution_id"
degree         ||--o{ candidate_education  : "degree_id"
specialization ||--o{ candidate_education  : "specialization_id"

' Row 2/5/6 → Row 10
candidate               ||--o{ candidate_skill        : "skills"
skill                   ||--o{ candidate_skill        : "skill_id"
skill_validation_status ||--o{ candidate_skill        : "validation"
candidate               ||--o{ candidate_document     : "documents"
candidate               ||--o{ candidate_social_media : "social links"

' Row 4/5/6 → Row 11
candidate            ||--o{ candidate_job : "application"
job_description      ||--o{ candidate_job : "job"
candidate_job_status ||--o{ candidate_job : "status"

' Row 5/11 → Row 12
candidate_job                   ||--|| candidate_job_evaluation : "evaluation"
candidate_job_evaluation_status ||--o{ candidate_job_evaluation : "status"

candidate_job                  ||--o{ candidate_job_interview : "interview"
candidate_job_interview_status ||--o{ candidate_job_interview : "status"

@enduml
